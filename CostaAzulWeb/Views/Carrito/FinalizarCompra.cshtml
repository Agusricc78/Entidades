@{
    ViewBag.Title = "Finalizar Compra";
}

<div class="min-h-screen bg-blue-50 p-10">
    <h1 class="text-3xl font-bold text-center text-blue-800 mb-6">Finalizar Compra</h1>

    <form asp-action="ConfirmarCompra" method="post" class="max-w-2xl mx-auto bg-white shadow-lg rounded-lg p-6">
        <!-- Nombre y Apellido -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="nombre" class="block text-sm font-medium text-gray-700">Nombre</label>
                <input type="text" id="nombre" name="nombre" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
            <div>
                <label for="apellido" class="block text-sm font-medium text-gray-700">Apellido</label>
                <input type="text" id="apellido" name="apellido" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
        </div>

        <!-- Email y Teléfono -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="mail" class="block text-sm font-medium text-gray-700">Correo Electrónico</label>
                <input type="email" id="mail" name="mail" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
            <div>
                <label for="telefono" class="block text-sm font-medium text-gray-700">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
        </div>

        <!-- Código Postal y Dirección -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label for="codigoPostal" class="block text-sm font-medium text-gray-700">Código Postal</label>
                <input type="text" id="codigoPostal" name="codigoPostal" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
            <div>
                <label for="direccion" class="block text-sm font-medium text-gray-700">Dirección</label>
                <input type="text" id="direccion" name="direccion" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required />
            </div>
        </div>

        <!-- Forma de Pago -->
        <div class="mb-4">
            <label for="formaPago" class="block text-sm font-medium text-gray-700">Forma de Pago</label>
            <select id="formaPago" name="formaPago" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required>
                <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
                <option value="Tarjeta de Débito">Tarjeta de Débito</option>
                <option value="Efectivo">Efectivo</option>
                <option value="MercadoPago">MercadoPago</option>
            </select>
        </div>

        <!-- Forma de Entrega -->
        <div class="mb-4">
            <label for="formaEntrega" class="block text-sm font-medium text-gray-700">Forma de Entrega</label>
            <select id="formaEntrega" name="formaEntrega" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" required>
                <option value="Envio">Envío</option>
                <option value="Retiro en Local">Retiro en Local</option>
            </select>
        </div>

        <!-- Botón de Confirmar Compra -->
        <div class="text-center mt-6">
            <button type="submit" class="bg-green-500 text-white px-6 py-2 rounded hover:bg-green-600">
                Pagar
            </button>
        </div>
    </form>
</div>

