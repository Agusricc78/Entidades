@model CostaAzulWeb.Models.CarritoViewModel;
@{
    ViewBag.Title = "Finalizar Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-blue-50 p-10">
    <h1 class="text-3xl font-bold text-center text-blue-800 mb-6">Finalizar Compra</h1>
    <form id="facturarForm" method="post">
        <input type="hidden" name="Id_Carrito" value="@Model.Id_Carrito" />

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="Nombre" class="block font-bold">Nombre</label>
                <input type="text" id="Nombre" name="Nombre" class="form-input w-full" required />
            </div>
            <div>
                <label for="Apellido" class="block font-bold">Apellido</label>
                <input type="text" id="Apellido" name="Apellido" class="form-input w-full" required />
            </div>
            <div>
                <label for="Mail" class="block font-bold">Correo Electrónico</label>
                <input type="email" id="Mail" name="Mail" class="form-input w-full" required />
            </div>
            <div>
                <label for="Telefono" class="block font-bold">Teléfono</label>
                <input type="text" id="Telefono" name="Telefono" class="form-input w-full" required />
            </div>
            <div>
                <label for="FormaPago" class="block font-bold">Forma de Pago</label>
                <select id="FormaPago" name="FormaPago" class="form-select w-full" required>
                    <option value="">Selecciona una opción</option>
                    <option value="Tarjeta">Tarjeta</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
            </div>
            <div>
                <label for="FormaEntrega" class="block font-bold">Forma de Entrega</label>
                <select id="FormaEntrega" name="FormaEntrega" class="form-select w-full" required>
                    <option value="">Selecciona una opción</option>
                    <option value="Retiro">Retiro en Local</option>
                    <option value="Envio">Envío</option>
                </select>
            </div>
        </div>

        <div class="mt-6 text-right">
            <button type="button" class="bg-green-500 text-black px-6 py-2 rounded hover:bg-green-600" onclick="irAPagar()">
                Ir a Pagar
            </button>
        </div>
        <div class="mt-6 text-right">
            <button type="button" class="bg-green-500 text-black px-6 py-2 rounded hover:bg-green-600" onclick="descargarFactura()">
                Finalizar
            </button>
        </div>
    </form>
</div>

<link rel="stylesheet" href="~/css/Finalizar.css">

<script>
    // Función para enviar el formulario al método de facturación y mostrar el explorador de archivos
      function descargarFactura() {
        const form = document.getElementById("facturarForm");
        const formData = new FormData(form);

        fetch('@Url.Action("Facturar", "Carrito")', {
            method: 'POST',
            body: formData
        })
        .then(response => {
            if (!response.ok) {
                throw new Error("Error al generar la factura");
            }
            return response.blob();
        })
        .then(blob => {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.style.display = "none";
            a.href = url;
            a.download = "Factura.pdf"; // Nombre sugerido
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
        })
        .catch(error => {
            alert("Error al generar la factura: " + error.message);
        });
    }

    // Simulación de función para ir a pagar (puedes personalizarlo)
    function irAPagar() {
        alert("Función de pago no implementada");
    }
</script>
