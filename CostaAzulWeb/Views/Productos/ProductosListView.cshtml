
@{
    ViewBag.Title = "ProductosListView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID Producto</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Código</th>
            <th>Categoría</th>
            <th>Activo</th>
            <th>Imagen</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Id_Producto</td>
                <td>@producto.Nombre</td>
                <td>@producto.Descripcion</td>
                <td>@producto.Precio</td>
                <td>@producto.Codigo</td>
                <td>@producto.Id_Categoria</td>
                <td>@(producto.Activo ? "Sí" : "No")</td>
                <td>
                    @if (!string.IsNullOrEmpty(producto.Imagen))
                    {
                        <img src="@Url.Content("~/Img/" + producto.Imagen)" alt="Imagen del producto" style="max-width: 100px; max-height: 100px;" />
                    }
                    else
                    {
                        <span>No hay imagen</span>
                    }
                </td>
                <td>@producto.Stock</td>
                <td>
                    <a href="@Url.Action("Edit", "Productos", new { id = producto.Id_Producto })" class="btn btn-primary">Modificar</a>
                    <a href="@Url.Action("Delete", "Productos", new { id = producto.Id_Producto })" class="btn btn-danger" onclick="return confirm('¿Está seguro de eliminar este producto?');">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>



