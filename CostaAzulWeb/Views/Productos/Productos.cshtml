@using Newtonsoft.Json
@model CostaAzulWeb.Models.ProductoViewModel

@{
    ViewBag.Title = "Gestión de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gestión de Productos</h1>

<!-- Mostrar el mensaje de respuesta -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<!-- Formulario para agregar o modificar un producto -->
<h2 id="form-title">Agregar o Modificar Producto</h2>
<form id="productoForm" asp-action="Create" asp-controller="Productos" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id_Producto" />

    <div class="form-group">
        <label asp-for="Id_Linea"></label>
        @if (Model.LineasSelectList != null && Model.LineasSelectList.Any())
        {
            @Html.DropDownListFor(m => m.Id_Linea, Model.LineasSelectList, "Seleccione una Linea", new { @class = "form-control" })
        }
        else
        {
            <p class="text-danger">No hay Lineas disponibles.</p>
        }
        <span asp-validation-for="Id_Linea" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Descripcion"></label>
        <textarea asp-for="Descripcion" class="form-control" placeholder="Ingrese una descripción del producto"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Precio"></label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="Ingrese el precio" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Codigo"></label>
        <input asp-for="Codigo" class="form-control"  placeholder="Ingrese el código" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Id_Categoria"></label>
        @if (Model.CategoriasSelectList != null && Model.CategoriasSelectList.Any())
        {
            @Html.DropDownListFor(m => m.Id_Categoria, Model.CategoriasSelectList, "Seleccione una categoría", new { @class = "form-control" })
        }
        else
        {
            <p class="text-danger">No hay categorías disponibles.</p>
        }
        <span asp-validation-for="Id_Categoria" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Id_Catalogo"></label>
        @if (Model.CatalogosSelectList != null && Model.CatalogosSelectList.Any())
        {
            @Html.DropDownListFor(m => m.Id_Catalogo, Model.CatalogosSelectList, "Seleccione un catálogo", new { @class = "form-control" })
        }
        else
        {
            <p class="text-danger">No hay catálogos disponibles.</p>
        }
        <span asp-validation-for="Id_Catalogo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control" type="number" placeholder="Ingrese el stock disponible" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Activo"></label>
        <input asp-for="Activo" type="checkbox" />
        <span asp-validation-for="Activo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Imagen">Imagen</label>
        <input type="file" id="Imagen" name="Imagen" class="form-control" accept="image/*" />
    </div>

    <button type="submit" id="form-submit" class="btn btn-success">Agregar Producto</button>
</form>

<hr />

<!-- Lista de productos -->
<h2>Lista de Productos</h2>
@if (Model.ListaProductos != null && Model.ListaProductos.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID Producto</th>
                <th>Id_Linea</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Código</th>
                <th>Categoría</th>
                <th>Catálogo</th>
                <th>Activo</th>
                <th>Imagen</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.ListaProductos)
            {
                <tr>
                    <td>@producto.Id_Producto</td>
                    <td>@producto.NombreLinea</td>
                    <td>@producto.Descripcion</td>
                    <td>@producto.Precio</td>
                    <td>@producto.Cod_Producto</td>
                    <td>@producto.NombreCategoria</td>
                    <td>@producto.Id_Catalogo</td>
                    <td>@(producto.Activo ? "Sí" : "No")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="@Url.Content("~/Img/" + producto.Imagen)" alt="Imagen del producto" style="max-width: 100px; max-height: 100px;" />
                        }
                        else
                        {
                            <span>No hay imagen</span>
                        }
                    </td>
                    <td>@producto.stock</td>
                    <td>
                        <button type="button" class="btn btn-primary edit-product" data-product='@Html.Raw(JsonConvert.SerializeObject(producto))'>Modificar</button>
                        <a asp-action="Delete" asp-controller="Productos" asp-route-id="@producto.Cod_Producto" class="btn btn-danger" onclick="return confirm('¿Está seguro de eliminar este producto?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay productos disponibles.</p>
}

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // Llenar formulario con datos del producto seleccionado
            $(".edit-product").on("click", function () {
                const producto = $(this).data("product");

                $("#productoForm").attr("action", "/Productos/Edit");
                $("#form-title").text("Modificar Producto");
                $("#form-submit").text("Modificar Producto");

                $("#Id_Producto").val(producto.Id_Producto);
                $("#Nombre").val(producto.Nombre);
                $("#Descripcion").val(producto.Descripcion);
                $("#Precio").val(producto.Precio);
                $("#Codigo").val(producto.Cod_Producto);
                $("#Id_Categoria").val(producto.Id_Categoria);
                $("#Id_Catalogo").val(producto.Id_Catalogo);
                $("#Stock").val(producto.Stock);
                $("#Activo").prop("checked", producto.Activo);
            });
        });
    </script>
}

