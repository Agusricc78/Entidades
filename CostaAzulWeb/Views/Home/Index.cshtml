@{
    ViewBag.Title = "Home Page";
}

<main style="background-color: floralwhite;">
    <!-- Inicio -->
    <section id="inicio" class="row position-relative" aria-labelledby="aboutTitle">
        <div class="col-12 text-center">
            <img class="img-fluid w-100" src="~/Img/Fondo.png" alt="Imagen de ejemplo" style="position: relative;">
            <h2 id="aboutTitle" class="text-center text-white position-absolute top-50 start-50 translate-middle" style="opacity: 0.8; font-size: 4rem; font-weight: bold;">
                Costa Azul
            </h2>
        </div>
    </section>

    <!-- Projects Section -->
    <div class="container mt-5">
        <div class="row">
            <!-- Ferrolux -->
            <div class="col-md-6 mb-4">
                <div class="card catalog-card">
                    <div class="catalog-image-container">
                        <img class="catalog-image" src="~/Img/fotocatalogoferrolux.png" alt="Ferrolux">
                    </div>
                    <div class="card-body text-center">
                        <h4 class="card-title">Ferrolux</h4>
                        <button class="btn btn-primary" onclick="location.href='@Url.Action("Ferrolux", "Productos", new { catalogo = "Ferrolux" })'">Ver Más</button>
                    </div>
                </div>
            </div>

            <!-- Rústica -->
            <div class="col-md-6 mb-4">
                <div class="card catalog-card">
                    <div class="catalog-image-container">
                        <img class="catalog-image" src="~/Img/catalogorustica.png" alt="Rústica">
                    </div>
                    <div class="card-body text-center">
                        <h4 class="card-title">Rústica</h4>
                        <button class="btn btn-primary" onclick="location.href='@Url.Action("Rustica", "Productos", new { catalogo = "Rustica" })'">Ver Más</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


   
    <!-- Sección Sobre Nosotros -->
    <section id="sobreNosotros" class="about-section">
        <h2 class="text-dark mb-4">Sobre Nosotros</h2>
        <div class="container">
            <p class="lead text-dark">
                En <strong>Costa Azul</strong>, somos líderes en la venta de iluminarias para hogares, negocios y proyectos arquitectónicos.
                Ofrecemos un extenso catálogo de productos para satisfacer las necesidades tanto de clientes mayoristas como minoristas.
                Nuestros valores fundamentales incluyen innovación, sostenibilidad y la excelencia en atención al cliente.
            </p>
            <p class="lead text-dark">
                Trabajamos directamente con fabricantes reconocidos para garantizar productos de alta calidad a precios competitivos.
                Con una logística ágil y eficiente, ofrecemos envíos rápidos y seguros a cualquier parte del país.
            </p>
        </div>
    </section>


    <!-- Sección de Contacto -->
    <section id="contacto" class="py-5 bg-white text-center contact-section">
        <h2 class="text-dark mb-4">Contacto</h2>
        <div class="container">
            <form>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control form-control-lg" placeholder="Nombre" required />
                    </div>
                    <div class="col-md-6">
                        <input type="email" class="form-control form-control-lg" placeholder="Correo Electrónico" required />
                    </div>
                </div>
                <div class="mb-3">
                    <textarea class="form-control form-control-lg" placeholder="Mensaje" rows="4" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-lg">Enviar</button>
            </form>
        </div>
    </section>
</main>

<link rel="stylesheet" href="~/css/index.css">
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
