@{
    ViewBag.Title = "Home Page";
}

<main style="background-color: floralwhite;">
    <!-- Botón Flotante de WhatsApp -->
    <a href="https://wa.me/1158979507?text=¡Hola!%20Quiero%20más%20información%20sobre%20sus%20productos."
       target="_blank"
       id="whatsappButton"
       style="position: fixed;
              bottom: 20px;
              right: 20px;
              z-index: 1000;
              background: #25d366;
              color: white;
              font-size: 36px;
              padding: 15px;
              border-radius: 50%;
              box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
              text-decoration: none;
              display: flex;
              align-items: center;
              justify-content: center;">
        <i class="fab fa-whatsapp"></i>
    </a>

    <!-- Inicio -->
    <section id="inicio" class="row position-relative" aria-labelledby="aboutTitle">
        <div class="col-12 text-center">
            <img class="img-fluid w-100" src="~/Img/Fondo.png" alt="Imagen de ejemplo" style="position: relative;">
            <h2 id="aboutTitle" class="text-center text-white position-absolute top-50 start-50 translate-middle" style="opacity: 0.8; font-size: 4rem; font-weight: bold;">
                Costa Azul
            </h2>
        </div>
    </section>

    <!-- Projects Section -->
    <div class="container mt-5">
        <div class="row">
            <!-- Ferrolux -->
            <div class="col-md-6 mb-4">
                <div class="card catalog-card">
                    <div class="catalog-image-container">
                        <img class="catalog-image" src="~/Img/fotocatalogoferrolux.png" alt="Ferrolux">
                    </div>
                    <div class="card-body text-center">
                        <h4 class="card-title">Ferrolux</h4>
                        <button class="btn btn-primary" onclick="location.href='@Url.Action("Ferrolux", "Productos", new { catalogo = "Ferrolux" })'">Ver Más</button>
                    </div>
                </div>
            </div>

            <!-- Rústica -->
            <div class="col-md-6 mb-4">
                <div class="card catalog-card">
                    <div class="catalog-image-container">
                        <img class="catalog-image" src="~/Img/catalogorustica.png" alt="Rústica">
                    </div>
                    <div class="card-body text-center">
                        <h4 class="card-title">Rústica</h4>
                        <button class="btn btn-primary" onclick="location.href='@Url.Action("Rustica", "Productos", new { catalogo = "Rustica" })'">Ver Más</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección Sobre Nosotros -->
    <section id="sobreNosotros" class="mt-5">
        <h2 class="text-dark mb-4">Sobre Nosotros</h2>
        <div class="container">
            <p class="lead text-dark">
                En <strong>Costa Azul</strong>, somos líderes en la venta de iluminarias para hogares, negocios y proyectos arquitectónicos.
                Ofrecemos un extenso catálogo de productos para satisfacer las necesidades tanto de clientes mayoristas como minoristas.
                Nuestros valores fundamentales incluyen innovación, sostenibilidad y la excelencia en atención al cliente.
            </p>
            <p class="lead text-dark">
                Trabajamos directamente con fabricantes reconocidos para garantizar productos de alta calidad a precios competitivos.
                Con una logística ágil y eficiente, ofrecemos envíos rápidos y seguros a cualquier parte del país.
            </p>
        </div>
    </section>

    <section class="u-align-center u-clearfix u-container-align-center u-section-1" id="sec-46dc" style="background-color: #007BFF; padding: 50px 0;">
        <div class="u-clearfix u-sheet u-sheet-1">
            <div class="row">
                <!-- Parte del Contacto -->
                <div class="col-md-6">
                    <div class="u-container-style u-layout-cell u-left-cell u-layout-cell-1" style="background-color: white; padding: 20px; border: 2px solid #ccc; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                        <h2 class="u-text u-text-1">Centro de negocios</h2>
                        <p class="u-text u-text-2">lanus</p>
                        <p class="u-text u-text-3">num de telefono</p>
                        <p class="u-text u-text-4">mail</p>
                        <form action="https://forms.nicepagesrv.com/v2/form/process" class="u-clearfix u-form-spacing-10 u-form-vertical u-inner-form" style="padding: 0px;" source="email" name="form-5">
                            <div class="u-form-group u-form-name u-label-none">
                                <label for="name-5359" class="u-label">Name</label>
                                <input type="text" placeholder="Name" id="name-5359" name="name" class="u-input u-input-rectangle" required="">
                            </div>
                            <div class="u-form-email u-form-group u-label-none">
                                <label for="email-5359" class="u-label">Email</label>
                                <input type="email" placeholder="Email" id="email-5359" name="email" class="u-input u-input-rectangle" required="">
                            </div>
                            <div class="u-form-group u-form-message u-label-none">
                                <label for="message-5359" class="u-label">Address</label>
                                <textarea placeholder="Address" rows="4" cols="50" id="message-5359" name="message" class="u-input u-input-rectangle" required=""></textarea>
                            </div>
                            <div class="u-form-group u-form-submit">
                                <button class="u-btn u-btn-submit u-button-style" style="background-color: #007BFF; color: white; border: none; border-radius: 5px;">Enviar</button>
                            </div>
                            <input type="hidden" value="" name="recaptchaResponse">
                            <input type="hidden" name="formServices" value="483d5d19-4b38-5589-632a-05f0eec0758e">
                        </form>
                    </div>
                </div>
                <!-- Parte del Mapa -->
                <div class="col-md-6">
                    <div class="u-container-style u-layout-cell u-right-cell u-layout-cell-2" style="height: 400px; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                        <iframe class="w-100 h-100" style="border: 0;" src="https://maps.google.com/maps?output=embed&amp;q=Manhattan%2C%20New%20York&amp;z=10&amp;t=m" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* fotter *@
    <section id="fotter" class="row position-relative" aria-labelledby="aboutTitle">
        <div class="col-12 text-center">
            <img class="img-fluid w-100" src="~/Img/Fondo.png" alt="Imagen de ejemplo" style="position: relative;">
            <h2 id="aboutTitle" class="text-center text-white position-absolute top-50 start-50 translate-middle" style="opacity: 0.8; font-size: 4rem; font-weight: bold;">
                Costa Azul
            </h2>
        </div>
    </section>

</main>

<link rel="stylesheet" href="~/css/index.css">
<link rel="stylesheet" type="text/css" href="~/css/Contacto.css">
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}