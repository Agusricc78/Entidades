<link rel="stylesheet" href="~/css/index.css">
<link rel="stylesheet" type="text/css" href="~/css/Contacto.css">
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <script>
            $(document).ready(function () {
            // Función para obtener los productos más vendidos
            function cargarProductosMasVendidos() {
                $.ajax({
                    url: '/Productos/GetProductosMasVendidos', // Ruta del controlador
                    type: 'GET',
                    success: function (productos) {
                        if (productos && productos.length > 0) {
                            generarCarrusel(productos);
                        } else {
                            alert('No hay productos más vendidos disponibles.');
                        }
                    },
                    error: function () {
                        alert('Error al cargar los productos más vendidos.');
                    }
                });
            }

            // Función para generar dinámicamente el carrusel
            function generarCarrusel(productos) {
                const indicadores = $('#carousel-indicators');
                const contenidoCarrusel = $('#carousel-inner');

                // Limpiar contenido previo
                indicadores.empty();
                contenidoCarrusel.empty();

                // Generar dinámicamente los indicadores y los slides
                productos.forEach((producto, index) => {
                    // Indicadores
                    const indicador = `
                        <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="${index}" class="${index === 0 ? 'active' : ''}" aria-current="${index === 0}" aria-label="Slide ${index + 1}"></button>
                    `;
                    indicadores.append(indicador);

                    // Slide del producto
                    const slide = `
                        <div class="carousel-item ${index === 0 ? 'active' : ''}">
                            <div class="row text-center justify-content-center">
                                <div class="col-12 col-md-6 mb-4">
                                    <div class="card shadow-lg border-0 rounded-3 d-flex flex-row product-card">
                                        <!-- Imagen del Producto -->
                                        <div class="col-md-6">
                                            <img class="card-img-top rounded-3" src="/Img/${producto.imagen}" alt="${producto.descripcion}" style="object-fit: cover; height: 100%; width: 100%;">
                                        </div>

                                        <!-- Contenido del Producto -->
                                        <div class="card-body d-flex flex-column justify-content-between col-md-6">
                                            <h5 class="card-title text-dark font-weight-bold">${producto.descripcion}</h5>
                                            <p class="card-text text-success"><strong>Precio:</strong> $${producto.precio}</p>
                                            <button class="btn btn-primary w-100 py-2 mt-3 agregar-carrito" data-producto-id="${producto.id_Producto}">Agregar al Carrito</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    contenidoCarrusel.append(slide);
                });

                // Evento para agregar productos al carrito
                $('.agregar-carrito').off('click').on('click', function () {
                    const idProducto = $(this).data('producto-id');
                    agregarProductoAlCarrito(idProducto);
                });
            }

            // Función para agregar un producto al carrito
            function agregarProductoAlCarrito(idProducto) {
                $.ajax({
                    url: '/Carrito/AgregarProducto', // Ruta del controlador para agregar productos
                    type: 'POST',
                    data: { Id_Producto: idProducto },
                    success: function (response) {
                        if (response.success) {
                            alert('Producto agregado al carrito correctamente.');
                        } else {
                            alert(response.message || 'Error al agregar el producto al carrito.');
                        }
                    },
                    error: function () {
                        alert('Error al intentar agregar el producto al carrito.');
                    }
                });
            }

            // Cargar los productos más vendidos al cargar la página
            cargarProductosMasVendidos();
        });



    </script>



}


