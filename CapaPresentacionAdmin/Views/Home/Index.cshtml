@{
    ViewBag.Title = "Home Page";
}

<h1 class="mt-4">Dashboard</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Dashboard</li>
</ol>


<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card bg-success text-white mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Cantidad Clientes</h6>
                        <h6 id="totalCliente">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-user fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-warning text-white mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total Pedidos</h6>
                        <h6 id="totalPedidos">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-shopping-bag fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-secondary text-white mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Cantidad Productos</h6>
                        <h6 id="totaProductos">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-boxes fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>



</div>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-tags me-1"></i>
        Historial Pedidos
    </div>
    <div class="card-body">

        <form action="@Url.Action("ExportarPedidos","Home")" method="post">
            <div class="row align-items-end">
                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Fecha de Inicio:</label>
                        <input type="text" class="form-control" id="txtFechaInicio" name="fechacreacion" />
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Fecha de Fin:</label>
                        <input type="text" class="form-control" id="txtFechaFin" name="fechafin" />
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Nro Pedido:</label>
                        <input type="text" class="form-control" id="txtNroPedido" name="nropedido" value="" />
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Estados:</label>
                        <select class="form-select" id="cboEstados" name="idestado">
                            <option value="2">Pendiente</option>
                            <option value="1">Creado</option>
                            <option value="3">Finalizado</option>
                        </select>
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="d-grid mb-2">
                        <button class="btn btn-primary" id="btnBuscar" type="button"><i class="fas fa-search"></i>Buscar</button>
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="d-grid mb-2">
                        <button class="btn btn-success" type="submit"><i class="fas fa-file-excel"></i>Exportar</button>
                    </div>
                </div>

            </div>
        </form>


        <hr />

        <div class="row">

            <div class="col-sm-12">
                <table id="tabla" class="display cell-border" style="width:100%">
                    <thead>
                        <tr>
                            <th>Fecha Pedido</th>
                            <th>Nro Pedido</th>
                            <th>Cliente</th>
                            <th>Productos</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Finalizado</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>


@section scripts{

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/smoothness/jquery-ui.css">

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>

    <script>


        var tabladata;
        var filaselccionada;

        $("#txtFechaInicio").datepicker({
            dateFormat: 'dd/mm/yy'
        }).datepicker('setDate', new Date());

        $("#txtFechaFin").datepicker({
            dateFormat: 'dd/mm/yy'
        }).datepicker('setDate', new Date());


        jQuery.ajax({
            url: '@Url.Action("GetReportes", "Home")',
            type: "GET",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                var objeto = data.resultado[0];
                $("#totalCliente").text(objeto.TotalClientes);
                $("#totalPedidos").text(objeto.TotalVentas);
                $("#totaProductos").text(objeto.TotalProductos);
            }
        });

        //string fechacreacion, string fechafin, string nropedido)

        var Url = '@Url.Action("GetPedidosPendientes","Home")' +
            "?fechacreacion=" + $("#txtFechaInicio").val() +
            "&fechafin=" + $("#txtFechaFin").val() +
            "&nropedido=" + $("#txtNroPedido").val() +
            "&idestado=" + $("#cboEstados").val();



        tabladata = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                  url: Url,
                  type: "GET",
                  dataType: "json",
            },
            "columns": [
                { "data": "FechaCreacion" },
                { "data": "NroPedido" },
                { "data": "Nombre" },
                { "data": "Producto" },
                { "data": "Cantidad" },
                { "data": "Totales" },
                { "data": "Estado" },
                {
                    "data": "Estado",  
                    "render": function (data, type, row) {
                        var content = '';
                        if (data == 'Pendiente') {
                            content = '<button type="button" class="btn btn-danger btn-sm btn-editar"> <i class="fa fa-times"></i></button>';
                        } else if (data == 'Finalizado') {
                            content = '<span class="badge bg-success">Si</span>';
                        } else {
                            content = '<span class="badge bg-danger">NO</span>';
                        }

                        return '<div class="text-center">' + content + '</div>';
                    },
                    "orderable": false,
                    "serchable": false,
                    "width": "50px"
                }

            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.2.1/i18n/es-ES.json"
            }
        });

        $("#tabla tbody").on("click", '.btn-editar', function () {
            var pedidoSeleccionado = $(this).closest("tr");

            var data = tabladata.row(pedidoSeleccionado).data();

        swal({
            title: "¿Entregaste el Pedido?",
            type: "warning",
            showCancelButton: true,
            confirmButtonClass: "btm-primary",
            confirmButtonText: "Si",
            cancelButtonText: "No",
            closeOnConfirm: true
        },
            function () {
                jQuery.ajax({
                    url: '@Url.Action("UpdateEstado", "Home")',
                    type: "POST",
                    data: JSON.stringify({ nropedido: data.NroPedido }),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.resultado == 1) {
                            window.location.reload();
                        } else {
                            swal("Error", data.mensaje, "error");
                        }
                    },
                    error: function (error) {
                        console.log(error);
                        swal("Error", "Hubo un problema con la solicitud", "error");
                    }
                });
            });
        })



        $("#btnBuscar").on("click", function () {

            var NuevaUrl = '@Url.Action("GetPedidosPendientes","Home")' +
            "?fechacreacion=" + $("#txtFechaInicio").val() +
            "&fechafin=" + $("#txtFechaFin").val() +
            "&nropedido=" + $("#txtNroPedido").val() +
            "&idestado=" + $("#cboEstados").val();


            tabladata.ajax.url(NuevaUrl).load();

        })



    </script>
}

