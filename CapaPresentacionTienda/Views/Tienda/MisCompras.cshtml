@model List<Entities.DetalleVenta>
@{
    ViewBag.Title = "MisCompras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row mt-5">
        <div class="col-sm-12">
            @{ 
                if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <div class="row mb-3">
                                <div class="col-sm-12">
                                    <div class="card">
                                        <div class="card-body bg-light">
                                             <h4>NRO PEDIDO : @item.Ventas.NroPedido</h4>
                                                <h6>ID TRANSACCION : @item.Ventas.Id_Transaccion</h6>
                                                <div class="table-responsive">

                                                    <table class="table table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th>Imagen</th>
                                                                <th>Producto</th>
                                                                <th>Precio Unitario</th>
                                                                <th>Cantidad</th>
                                                                <th>Sub Total</th>
                                                            </tr>

                                                        </thead>

                                                        <tbody class="bg-white">
                                                            <tr>
                                                                <td>
                                                                    <img class="card-img-top mb-5 mb-md-0" src=" @item.Productos.Imagen ? data:image/@item.Productos.Imagen + @item.Productos.ExtImagen;base64; @item.Productos.Imagen" style="width:120px;height:120px" />
                                                                </td>
                                                                <td valign="middle">
                                                                    @item.Productos.Nombre
                                                                </td>
                                                                <td valign="middle">
                                                                    $ @item.Productos.Precio
                                                                </td>
                                                                <td valign="middle">
                                                                    @item.Cantidad
                                                                </td>
                                                                <td valign="middle">
                                                                   $ @item.Total
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                        </div>
                                    </div>
                                </div>
                        </div>
                    }
                }
                else
                {
                    <div class="row mb-3">
                        <div class="col-sm-12 text-center">
                            <h1>No se encontro ninguna compra</h1>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
