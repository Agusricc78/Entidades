
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header-->
<header class="bg-dark py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="text-center text-white">
            <h1 class="display-4 fw-bolder">Costa Azul</h1>
            <p class="lead fw-normal text-white-50 mb-0">Casa de Materiales Electricos e Iluminacion</p>
        </div>
    </div>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button type="button" class="btn btn-outline-secondary btn-lg text-white" id="btnMateriaelectrico">Materiales Electricos</button>
        <button type="button" class="btn btn-outline-secondary btn-lg text-white" id="btnIluminacion">Iluminación</button>
        <button type="button" class="btn btn-outline-secondary btn-lg text-white" id="btnVarios">Varios</button>
    </div>
</header>

<!-- Section-->
<section>
    <div class="container-fluid px-5 my-5">
        <div class="row">
            <div class="col-sm-3">
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-header bg-dark text-white">
                                Catalogos
                            </div>
                            <div id="contenedor_catalogo" class="card-body">
                                <div id="contenedor_Linea" class="card-body">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="catalogos" value="0" id="cx0" checked="checked">
                                        <label class="form-check-label" for="cx0">
                                            Todos
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="catalogos" value="1" id="cx1">
                                        <label class="form-check-label" for="cx1">
                                            Ferrolux
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="catalogos" value="2" id="cx2">
                                        <label class="form-check-label" for="cx2">
                                            Rustica
                                        </label>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-header bg-dark text-white">
                                Productos
                            </div>
                            <div id="contenedor_electricos" class="card-body">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="electricos" value="" id="cx01" checked="checked">
                                    <label class="form-check-label" for="cx01">
                                        Todos
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="electricos" value="Materiales Electricos" id="cx3">
                                    <label class="form-check-label" for="cx3">
                                        Electricos
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="electricos" value="Iluminacion" id="cx4">
                                    <label class="form-check-label" for="cx3">
                                        Iluminacion
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="electricos" value="Varios" id="cx5">
                                    <label class="form-check-label" for="cx3">
                                        Varios
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
