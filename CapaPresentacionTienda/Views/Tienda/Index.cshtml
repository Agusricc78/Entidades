@section scripts{
    <script>

        $(document).ready(function () {
            //MostrarCategorias();

            $('#searchButton').on('click', function () {
                var searchText = $('#searchInput').val();
                console.log("Valor de búsqueda: ", searchText);
                if (searchText) {
                    MostrarProductos(0, 0, 0, "", searchText); 
                }
            });

            $('#searchInput').on('keypress', function (e) {
                if (e.which === 13) {  // 13 es la tecla Enter
                    var searchText = $('#searchInput').val();
                    if (searchText) {
                        MostrarProductos(0, 0, 0, "", searchText);  // Llamada AJAX también
                    }
                }
            });

            MostrarProductos(0, 0, 0, "");


            $("input[name=categoria], input[name=linea], input[name=catalogos], input[name=electricos]").change(function () {
                var Id_Catalogo = $("input[name=catalogos]:checked").val();
                var Electrico = $("input[name=electricos]:checked").val();

                MostrarProductos(0, 0, Id_Catalogo, Electrico);
            });

            $("#searchInput").on("keyup", function () {
                let query = $(this).val().trim();

                if (query.length > 0) {
                    $.ajax({
                        url: '@Url.Action("BuscarProductos", "Tienda")',
                        type: "POST",
                        data: JSON.stringify({ texto: query }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (response) {
                            $("#sugerenciasBusqueda").empty().show();

                            if (response.data.length > 0) {
                                $.each(response.data, function (i, producto) {
                                    let imagen = producto.Imagen ? "data:image/" + producto.ExtImagen + ";base64," + producto.Imagen : "URL_DE_IMAGEN_POR_DEFECTO";
                                    let sugerencia = $("<a>").addClass("list-group-item list-group-item-action")
                                        .attr("href", '@Url.Action("DetalleProducto", "Tienda")?Id_Producto=' + producto.Id_Producto)  // Establecer el href aquí
                                        .data("idProducto", producto.Id_Producto)
                                        .append(
                                            $("<div>").addClass("d-flex align-items-center").append(
                                                $("<img>").addClass("me-2 img-thumbnail")
                                                    .attr("src", imagen)
                                                    .css({ "width": "40px", "height": "40px", "object-fit": "cover" }),
                                                $("<div>").append(
                                                    $("<h6>").text(producto.Nombre),
                                                    $("<p>").addClass("text-muted").text(producto.Descripcion),
                                                    $("<p>").addClass("text-success").text("$" + producto.Precio.toFixed(2))
                                                )
                                            )
                                        );

                                    $("#sugerenciasBusqueda").append(sugerencia);
                                });
                            } else {
                                $("#sugerenciasBusqueda").append($("<a>").addClass("list-group-item").text("No se encontraron productos"));
                            }
                        },
                        error: function () {
                            //alert("Error al buscar productos.");
                        }
                    });
                } else {
                    $("#sugerenciasBusqueda").empty().hide();
                }
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest('#searchInput').length && !$(e.target).closest('#sugerenciasBusqueda').length) {
                    $("#sugerenciasBusqueda").empty().hide();
                }
            });
        });


        function ExisteProductoEnCarrito(idProducto, callback = function () {}) {


            $.ajax({
                url: "@Url.Action("ExisteProductoCarrito", "Tienda")",
                type: "POST",
                data: JSON.stringify({ idproducto: idProducto }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (response) {


                    if (typeof callback === "function") {
                        callback(response.respuesta > 0, response.cantidad || 0);
                    } else {

                    }
                },
                error: function () {

                    if (typeof callback === "function") {
                        callback(false, 0);
                    }
                }
            });
        }

      function MostrarCategorias() {
            jQuery.ajax({
                url: "@Url.Action("GetCategorias", "Tienda")",
                type: "GET",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    $("#contenedor_categoria").html("");
                    $("#contenedor_categoria").LoadingOverlay("hide");

                    $("<div>").addClass("form-check form-switch").append(
                        $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "categoria", "value": "0", "id": "Cx" }).prop("checked", true),
                        $("<label>").addClass("form-check-label").text("Todos").attr({ "for": "Cx" })
                    ).appendTo("#contenedor_categoria");

                    $.each(response.data, function (i, element) {
                        $("<div>").addClass("form-check form-switch").append(
                            $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "categoria", "value": element.Id_Categoria, "id": "c" + i }),
                            $("<label>").addClass("form-check-label").text(element.Nombre).attr({ "for": "c" + i })
                        ).appendTo("#contenedor_categoria");
                    });

                    MostrarLineas();
                },
                beforeSend: function () {
                    $("#contenedor_categoria").LoadingOverlay("show");
                }
            });
        }

        function MostrarLineas() {
            var Id_Categoria = $("input[name=categoria]:checked").val();


          jQuery.ajax({
              url: "@Url.Action("GetLineasCategoria", "Tienda")",
              type: "POST",
              data: JSON.stringify({ Id_Categoria: Id_Categoria }),
              dataType: "json",
              contentType: "application/json; charset=utf-8",
              success: function (response) {
                  $("#contenedor_linea").html("");
                  $("#contenedor_linea").LoadingOverlay("hide");

                  $("<div>").addClass("form-check").append(
                      $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "linea", "value": "0", "id": "lx" }).prop("checked", true),
                      $("<label>").addClass("form-check-label").text("Todos").attr({ "for": "lx" })
                  ).appendTo("#contenedor_linea");

                  $.each(response.data, function (i, element) {
                      $("<div>").addClass("form-check").append(
                          $("<input>").addClass("form-check-input").attr({ "type": "radio", "name": "linea", "value": element.Id_Linea, "id": "l" + i }),
                          $("<label>").addClass("form-check-label").text(element.Nombre).attr({ "for": "l" + i })
                      ).appendTo("#contenedor_linea");
                  });
              },
              beforeSend: function () {
                  $("#contenedor_linea").LoadingOverlay("show");
              }
          });
        }

        function MostrarProductos(Id_Categoria, Id_Linea, Id_Catalogo, Elecrico, page = 1) {
            var nombreProducto = $("#searchInput").val();  // Correcto
            var pageSize = 12; 

        jQuery.ajax({
            url: '@Url.Action("getProductos", "Tienda")',
            type: "POST",
            data: JSON.stringify({ Id_Categoria: Id_Categoria, Id_Linea: Id_Linea, Id_Catalogo: Id_Catalogo, Elecrico: Elecrico, nombreProducto: nombreProducto, page: page, pageSize: pageSize }),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                $("#contenedor_producto").html("");
                $("#contenedor_producto").LoadingOverlay("hide");

                $.each(response.data, function (i, element) {


                    let idProducto = element.Id_Producto;
                    let cardFooter = $("<div>").addClass("card-footer pt-0 border-top-0 bg-transparent");

                    ExisteProductoEnCarrito(element.Id_Producto, function (enCarrito, cantidad) {

                     cardFooter.empty();

                    if (element.stock > 0) {

                        if (enCarrito) {
                            let botonesContainer = $("<div>").addClass("d-flex justify-content-center align-items-center gap-2");

                            botonesContainer.append(
                                $("<button>").addClass("btn btn-outline-danger btn-restar rounded-0")
                                    .append($("<i>").addClass("fas fa-minus"))
                                    .data("Id_Producto", element.Id_Producto),

                                $("<input>").addClass("form-control input-cantidad text-center rounded-0")
                                    .prop("disabled", true)
                                    .attr("id", "cantidad_" + element.Id_Producto)
                                    .attr("name", "cantidad_" + element.Id_Producto)
                                    .css({ "width": "50px" })
                                    .data("producto", element)
                                    .val(cantidad),

                                $("<button>").addClass("btn btn-outline-primary btn-sumar rounded-0")
                                    .append($("<i>").addClass("fas fa-plus"))
                                    .data("Id_Producto", element.Id_Producto)
                            );

                            // Añadir al `cardFooter`
                            cardFooter.append(botonesContainer);
                        } else {
                            // Si el producto NO está en el carrito, mostrar "Agregar al carrito"
                            cardFooter.append(
                                $("<button>").addClass("btn btn-success mt-auto agregarcarrito ")
                                    .css("margin-right", "10px")
                                    .data("Id_Producto", element.Id_Producto)
                                    .text("Agregar al carrito"),

                                $("<a>").addClass("btn btn-dark mt-auto")
                                    .attr({ "href": "@Url.Action("DetalleProducto", "Tienda")?Id_Producto=" + element.Id_Producto })
                                    .text("Ver Detalle")
                            );
                        }
                    } else {
                        // Si no hay stock, solo mostramos "Consultar"
                        cardFooter.append(
                            $("<button>").addClass("btn btn-light mt-auto w-100").text("Consultar")
                        );
                    }

                });

                    let productCard = $("<div>").addClass("col-12 col-md-6 mb-5").append(
                        $("<div>").addClass("card h-100").append(
                            $("<img>").addClass("card-img-top img-fluid")
                                .css("width", "100%")
                                .attr("src", element.Imagen ? "data:image/" + element.ExtImagen + ";base64," + element.Imagen : "URL_DE_IMAGEN_POR_DEFECTO"),
                            $("<div>").addClass("card-body p-4").append(
                                $("<div>").addClass("text-center").append(
                                    $("<h5>").addClass("fw-bolder").text(element.Nombre),
                                    $("<p>").text("$" + element.Precio.toFixed(2))
                                )
                            ),
                            $("<div>").addClass("text-center").append(
                                (element.stock <= 0 ? $("<p>").addClass("text-danger fw-bold").text("¡Agotado!") : ""),
                            ),
                            $("<div>").addClass("d-grid gap-2").append(cardFooter)
                        )
                    );

                    productCard.appendTo("#contenedor_producto");

                    ExisteProductoEnCarrito(idProducto);
                });

                mostrarPaginacion(response.totalProducts, page, pageSize);
            },
            beforeSend: function () {
                $("#contenedor_producto").LoadingOverlay("show");
            }
        });
        }


        function mostrarPaginacion(totalProducts, currentPage, pageSize) {
            var totalPages = Math.ceil(totalProducts / pageSize);  // Calcular el total de páginas
            var paginationContainer = $("#pagination-container");  // Asume que tienes un contenedor con este id para los botones

            paginationContainer.html("");  // Limpiar contenedor de paginación

            if (totalPages > 1) {
                // Contenedor para los elementos de paginación (centrado)
                var paginationList = $("<ul>").addClass("pagination d-flex justify-content-center");

                // Anterior
                var previousPage = $("<li>").addClass("page-item")
                    .addClass(currentPage === 1 ? "disabled" : "")
                    .append($("<a>").addClass("page-link btn-outline-dark")
                        .attr("href", currentPage > 1 ? "#" : "#")
                        .text("Anterior")
                        .on("click", function () {
                            if (currentPage > 1) {
                                MostrarProductos(0, 0, 0, "", currentPage - 1, 12);
                            }
                        }));

                paginationList.append(previousPage);

                // Páginas
                for (var i = 1; i <= totalPages; i++) {
                    var pageItem = $("<li>").addClass("page-item")
                        .addClass(currentPage === i ? "active" : "")
                        .append($("<a>").addClass("page-link")
                            .attr("href", "#")
                            .text(i)
                            .on("click", function () {
                                var selectedPage = parseInt($(this).text());
                                MostrarProductos(0, 0, 0, "", selectedPage, 12);
                            }));

                    paginationList.append(pageItem);
                }

                // Siguiente
                var nextPage = $("<li>").addClass("page-item")
                    .addClass(currentPage === totalPages ? "disabled" : "")
                    .append($("<a>").addClass("page-link btn-outline-dark")
                        .attr("href", currentPage < totalPages ? "#" : "#")
                        .text("Siguiente")
                        .on("click", function () {
                            if (currentPage < totalPages) {
                                MostrarProductos(0, 0, 0, "", currentPage + 1, 12);
                            }
                        }));

                paginationList.append(nextPage);

                // Añadir la lista de paginación al contenedor
                paginationContainer.append(paginationList);
            }
        }




             $(document).on("click", ".btn-sumar", function(){
                 var div_contenedor = $(this).parent("div.d-flex");

                 var input_cantidad = $(div_contenedor).find("input.input-cantidad");

                 var btn = $(this)
                 var producto = $(input_cantidad).data("producto")

                 var idproducto = parseFloat(producto.Id_Producto) || 0;

                 jQuery.ajax({
                     url: '@Url.Action("OperacioCarrito", "Tienda")',
                     type: "POST",
                     data: JSON.stringify({ idproducto: idproducto, sumar: true }),
                     dataType: "json",
                     contentType: "application/json; charset=utf-8",
                     success: function (data) {

                         $(btn).LoadingOverlay("hide")

                         if (data.respuesta) {
                             var cantidad = parseInt($(input_cantidad).val()) + 1;
                             $(input_cantidad).val(cantidad)


                         } else {
                             swal("",data.mensaje,"warning")
                         }
                     },
                     beforeSend: function ()
                     {
                         $(btn).LoadingOverlay("show")
                     },
                     error: function (error) {
                         $(btn).LoadingOverlay("hide")
                     }
                 })
             })

           $(document).on("click", ".btn-restar", function(){
           var div_contenedor = $(this).parent("div.d-flex");

           var input_cantidad = $(div_contenedor).find("input.input-cantidad");

           var btn = $(this)
           var producto = $(input_cantidad).data("producto")

           var idproducto = parseFloat(producto.Id_Producto) || 0;

           var cantidad = parseInt($(input_cantidad).val()) - 1;

           if (cantidad >= 1) {
               jQuery.ajax({
                  url: '@Url.Action("OperacioCarrito", "Tienda")',
                  type: "POST",
                  data: JSON.stringify({ idproducto: idproducto, sumar: false }),
                  dataType: "json",
                  contentType: "application/json; charset=utf-8",
                  success: function (data) {

                      $(btn).LoadingOverlay("hide")

                      if (data.respuesta) {

                          $(input_cantidad).val(cantidad)


                      } else {
                          swal("",data.mensaje,"warning")
                      }
                  },
                  beforeSend: function ()
                  {
                      $(btn).LoadingOverlay("show")
                  },
                  error: function (error) {
                      $(btn).LoadingOverlay("hide")
                  }
              })
           }
       })

        $("#btnAplicarFiltro").click(function () {

            MostrarProductos(0, 0, 0, "");
        })


        $("#btnMateriaelectrico").click(function () {

            MostrarProductos(0, 0, 0, "Materiales Electricos");
        })

        $("#btnIluminacion").click(function () {

            MostrarProductos(0, 0, 0, "Iluminacion");
        })

        $(document).on("change","input[name=categoria]", function () {
            MostrarLineas();
        })


        $(document).on("click", "button.agregarcarrito", function () {

            console.log($(this).data("Id_Producto"))

            jQuery.ajax({
            url: '@Url.Action("AgregarCarrito", "Tienda")',
            type: "POST",
            data: JSON.stringify({ idproducto : $(this).data("Id_Producto")}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                if (data.respuesta > 0) {
                    MostrarCantidadCarrito();
                    MostrarProductos(0, 0, 0, "");
                } else {

                    swal("", data.mensaje, "warning");
                }

            }
            });

        });

    </script>

}