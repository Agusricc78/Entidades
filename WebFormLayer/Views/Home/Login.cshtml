
%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="YourNamespace.Login" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="Content/styles.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <h2>Iniciar Sesión</h2>
        <form id="loginForm" runat="server">
            <div>
                <label for="username">Usuario</label>
                <input type="text" id="username" runat="server" placeholder="Ingrese su usuario" required />
            </div>
            <div>
                <label for="password">Contraseña</label>
                <input type="password" id="password" runat="server" placeholder="Ingrese su contraseña" required />
            </div>
            <div>
                <button type="submit" runat="server" id="btnLogin">Ingresar</button>
            </div>
        </form>
    </div>
</body>
</html>

