
@{
    Layout = "~/Views/Shared/_Layout.cshtml";  // Si no tienes un layout o lo configuras en el controlador
}

@model WebFormLayer.Models.LoginViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="Content/styles.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <h2>Iniciar Sesión</h2>

        @* Mostrar mensaje de éxito o error desde TempData *@
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">
                @TempData["Message"]
            </div>
           

        }

        @using (Html.BeginForm("ValidUser", "Login", FormMethod.Post))
        {
            <div>
                <label for="Username">Usuario</label>
                @Html.TextBoxFor(m => m.Username, new { placeholder = "Ingrese su usuario", required = "required" })
            </div>
            <div>
                <label for="Password">Contraseña</label>
                @Html.PasswordFor(m => m.Password, new { placeholder = "Ingrese su contraseña", required = "required" })
            </div>
            <div>
                <button type="submit">Ingresar</button>
            </div>
        }
       
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
            }
    </div>
</body>
</html>


