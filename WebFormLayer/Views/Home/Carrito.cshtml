
@{
    ViewBag.Title = "Carrito";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 20px;
        }

        .cart-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #fff;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .product-list {
            list-style: none;
            padding: 0;
        }

            .product-list li {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-bottom: 1px solid #ddd;
            }

                .product-list li:last-child {
                    border-bottom: none;
                }

        .product-details {
            display: flex;
            justify-content: space-between;
            width: 100%;
        }

        .subtotal-container {
            text-align: right;
            font-size: 1.2em;
            margin-top: 20px;
        }

        .total {
            font-weight: bold;
            font-size: 1.5em;
        }

        .button-container {
            margin-top: 20px;
            text-align: center;
        }

            .button-container button {
                padding: 10px 20px;
                margin: 5px;
                font-size: 1em;
                border: none;
                cursor: pointer;
                background-color: #007bff;
                color: white;
                border-radius: 5px;
            }

                .button-container button:hover {
                    background-color: #0056b3;
                }
    </style>
</head>
<body>

    <div class="cart-container">
        <h1>Carrito de Compras</h1>

        <ul class="product-list">
            <li>
                <div class="product-details">
                    <span>Producto 1</span>
                    <span>Cantidad: 2</span>
                    <span>$50.00</span>
                </div>
            </li>
            <li>
                <div class="product-details">
                    <span>Producto 2</span>
                    <span>Cantidad: 1</span>
                    <span>$30.00</span>
                </div>
            </li>
            <li>
                <div class="product-details">
                    <span>Producto 3</span>
                    <span>Cantidad: 3</span>
                    <span>$20.00</span>
                </div>
            </li>
        </ul>

        <div class="subtotal-container">
            <p><span>Total productos:</span> <span>6</span></p>
            <p class="total"><span>Subtotal:</span> <span>$190.00</span></p>
        </div>

        <!-- Botones de acción -->
        <div class="button-container">
            <button onclick="location.href='index.html'">Volver al Menú Principal</button>
            <button onclick="location.href='agregar-productos.html'">Agregar Más Productos</button>
            <button onclick="location.href='cancelar-compra.html'">Cancelar Compra</button>
        </div>
    </div>

</body>
</html>


