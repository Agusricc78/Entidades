@model WebFormLayer.Models.ProductoViewModel

@{
    ViewBag.Title = "Gestión de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Gestión de Productos</h1>

<!-- Mostrar el mensaje de respuesta -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<!-- Formulario para agregar un nuevo producto -->
<h2>Agregar Nuevo Producto</h2>
@using (Html.BeginForm("Create", "Productos", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="Nombre">Nombre</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ingrese el nombre del producto" })
    </div>

    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control", placeholder = "Ingrese una descripción del producto" })
    </div>

    <div class="form-group">
        <label for="Precio">Precio</label>
        @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", placeholder = "Ingrese el precio", type = "number", step = "0.01" })
    </div>

    <div class="form-group">
        <label for="Codigo">Código</label>
        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control", placeholder = "Ingrese el código", type = "number" })
    </div>

    <div class="form-group">
        <label for="Id_Categoria">Categoría</label>
        @if (Model.CategoriasSelectList != null && Model.CategoriasSelectList.Any())
        {
            @Html.DropDownListFor(m => m.Id_Categoria, Model.CategoriasSelectList, "Seleccione una categoría", new { @class = "form-control" })
        }
        else
        {
            <p class="text-danger">No hay categorías disponibles.</p>
        }
    </div>

    <div class="form-group">
        <label for="Stock">Stock</label>
        @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", placeholder = "Ingrese el stock disponible", type = "number" })
    </div>

    <div class="form-group">
        <label for="Activo">Activo</label>
        @Html.CheckBoxFor(m => m.Activo)
    </div>

    <div class="form-group">
        <label for="Imagen">Imagen</label>
        <input type="file" id="Imagen" name="Imagen" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-success">Agregar Producto</button>
}

<hr />

<!-- Lista de productos -->
<h2>Lista de Productos</h2>
@if (Model.ListaProductos != null && Model.ListaProductos.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID Producto</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Código</th>
                <th>Categoría</th>
                <th>Activo</th>
                <th>Imagen</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.ListaProductos)
            {
                <tr>
                    <td>@producto.Id_Producto</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.Descripcion</td>
                    <td>@producto.Precio</td>
                    <td>@producto.Cod_Producto</td>
                    <td>@producto.NombreCategoria</td>
                    <td>@(producto.Activo ? "Sí" : "No")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(producto.Imagen))
                        {
                            <img src="@Url.Content("~/Img/" + producto.Imagen)" alt="Imagen del producto" style="max-width: 100px; max-height: 100px;" />
                        }
                        else
                        {
                            <span>No hay imagen</span>
                        }
                    </td>
                    <td>@producto.stock</td>
                    <td>
                        <a href="@Url.Action("Edit", "Productos", new { id = producto.Id_Producto })" class="btn btn-primary">Modificar</a>
                        <a href="@Url.Action("Delete", "Productos", new { id = producto.Cod_Producto })" class="btn btn-danger" onclick="return confirm('¿Está seguro de eliminar este producto?');">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay productos disponibles.</p>
}
